# Copy this file to `.env.local` and fill in your values.
# `.env.local` is gitignored; `.env.example` is committed as a template.

# ── Convex (required for the live backend) ───────────────────────────────────────
# Create a free deployment: `npx convex dev` then paste the URL it prints.
# When this is UNSET the app runs in offline/preview mode using the local shim.
VITE_CONVEX_URL=

# Set by `npx convex dev` / `npx convex deploy` — identifies your deployment.
CONVEX_DEPLOYMENT=

# ── Convex Auth (email OTP sign-in) ─────────────────────────────────────────────
# Generate with: `npx @convex-dev/auth` (or your provider). Not needed for offline mode.
JWKS=
JWT_PRIVATE_KEY=
SITE_URL=http://localhost:5173

# ── Owner workspace ──────────────────────────────────────────────────────────────
# The email allowed to access the owner workspace at /dashboard. Set this to YOUR
# email so you claim the workspace. Defaults to the original owner's email if unset,
# so forkers MUST override it or they'll be locked out.
OWNER_EMAIL=
