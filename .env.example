# Copy this file to `.env.local` and fill in your values.
# `.env.local` is gitignored; `.env.example` is committed as a template.

# ── Convex (required for the live backend) ───────────────────────────────────────
# Create a free deployment: `npx convex dev` then paste the URL it prints.
# When this is UNSET the app runs in offline/preview mode using the local shim.
VITE_CONVEX_URL=

# Set by `npx convex dev` / `npx convex deploy` — identifies your deployment.
CONVEX_DEPLOYMENT=

# ── Convex Auth (email OTP sign-in) ─────────────────────────────────────────────
# Generate with: `npx @convex-dev/auth` (or your provider). Not needed for offline mode.
JWKS=
JWT_PRIVATE_KEY=
SITE_URL=http://localhost:5173

# ── Owner workspace ──────────────────────────────────────────────────────────────
# The email allowed to access the owner workspace at /dashboard. Set this to YOUR
# email so you claim the workspace. Defaults to the original owner's email if unset,
# so forkers MUST override it or they'll be locked out.
OWNER_EMAIL=

# ── Resend (optional — powers BOTH dashboard reply emails AND login OTPs) ─────────
# When RESEND_API_KEY is set, two things use it:
#   1. The dashboard's "Reply" button emails your response to the visitor.
#   2. Email-OTP login (the /auth page) sends the 6-digit code via Resend instead of
#      a third party.
# Without it, replies are still SAVED in the inbox thread (not emailed) and login
# codes can't be sent. Get a free key at https://resend.com (3k emails/mo).
RESEND_API_KEY=

# Sender identity for ALL Resend email (replies + login OTPs). Falls back to
# "Sahil Shedge <onboarding@resend.dev>" (Resend's test sender) when unset.
# The test sender works for testing but may land in spam / get blocked, so for
# reliable delivery VERIFY A DOMAIN first (https://resend.com/domains) and then set
# this to a sender on that domain, e.g.:
#   RESEND_FROM=Sahil Shedge <noreply@yourdomain.com>
# No code change needed later — just update this value to switch to your custom domain.
#
# ── Adding a custom domain (one-time) ────────────────────────────────────────────
#   1. In Resend: Domains → Add Domain (e.g. yourdomain.com).
#   2. Add the DNS records Resend shows you (SPF, DKIM, and DMARC TXT/CNAME).
#   3. Wait for the domain status to show "Verified" (DNS propagation can take minutes).
#   4. Create a sender address on that domain (e.g. noreply@yourdomain.com) if prompted.
#   5. Set RESEND_FROM above to that verified sender and re-run `npx convex env set RESEND_FROM "Sahil Shedge <noreply@yourdomain.com>"`.
# After that, BOTH dashboard reply emails AND login OTPs send from your domain.
RESEND_FROM=
